        if p ~= LocalPlayer then
            count = count + 1
            local role = GetRole(p)
            local color = role == "MURDERER" and Color3.fromRGB(200, 50, 50) or (role == "SHERIFF" and Color3.fromRGB(50, 100, 200) or Color3.fromRGB(50, 180, 50))
