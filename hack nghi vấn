function RefreshList()
    local murderer = FindMurderer()
    if murderer then
        KillerLabel.Text = "🔴 KE GIET: " .. murderer.Name; KillerFrame.BackgroundColor3 = Color3.fromRGB(200, 30, 30)
    else
        KillerLabel.Text = "🟡 Chua tim thay Ke Giet"; KillerFrame.BackgroundColor3 = Color3.fromRGB(50, 50, 10)
    end
    pcall(function()
        for _, c in pairs(ScrollFrame:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
        local all = Players:GetPlayers(); table.sort(all, function(a,b) return a.Name < b.Name end)
        local count = 0
        for _, p in pairs(all) do
            if p ~= LocalPlayer then
                count = count + 1
                local role = GetRole(p)
                local color = role == "MURDERER" and Color3.fromRGB(200, 50, 50) or (role == "SHERIFF" and Color3.fromRGB(50, 100, 200) or Color3.fromRGB(50, 180, 50))
                local tag = role == "MURDERER" and "🔴" or (role == "SHERIFF" and "🔵" or "🟢")
                local pf = Instance.new("Frame", ScrollFrame); pf.Size = UDim2.new(1, -2, 0, 22); pf.BackgroundColor3 = color
                local btn = Instance.new("TextButton", pf); btn.Size = UDim2.new(1, 0, 1, 0); btn.BackgroundTransparency = 0.7; btn.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
                btn.Text = tag .. " " .. p.Name; btn.TextColor3 = Color3.new(1, 1, 1); btn.Font = Enum.Font.SourceSans; btn.TextSize = 9
                btn.MouseButton1Click:Connect(function() TPTo(p) end)
                btn.MouseButton2Click:Connect(function() ShowRoleMenu(p, UserInputService:GetMouseLocation()) end)
            end
        end
        ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, count * 24)
    end)
end

