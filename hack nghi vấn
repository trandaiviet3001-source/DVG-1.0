-- Hàm lấy character an toàn
local function getCharacter()
    if player and player.Character then
        return player.Character
    end
    return nil
end

local function getHumanoid()
    local char = getCharacter()
    if char then
        return char:FindFirstChild("Humanoid")
    end
    return nil
end

-- Hàm getRoles an toàn (fix lỗi nil)
local function getRoles()
    local murderers, polices, innocents = {}, {}, {}
    local allPlayers = players:GetPlayers()
    if not allPlayers or #allPlayers == 0 then return murderers, polices, innocents end
    
    for _, v in pairs(allPlayers) do
        if v and v ~= player then
            local char = v.Character
            if char and char:FindFirstChild("Humanoid") and char:FindFirstChild("HumanoidRootPart") then
                local isMurderer, isPolice = false, false
                -- Kiểm tra tool an toàn
                local tools = char:GetChildren()
                for _, tool in pairs(tools) do
                    if tool and tool:IsA("Tool") then
                        local name = string.lower(tool.Name or "")
                        if string.find(name, "knife") or string.find(name, "sword") or string.find(name, "blade") or string.find(name, "dagger") then
                            isMurderer = true
                        elseif string.find(name, "gun") or string.find(name, "pistol") or string.find(name, "revolver") or string.find(name, "sheriff") then
                            isPolice = true
                        end
                    end
                end
                -- Fallback attribute an toàn
                if not isMurderer then
                    local attr = pcall(function() return v:GetAttribute("Murderer") end)
                    if attr and attr then isMurderer = true end
                end
                if not isPolice then
                    local attr = pcall(function() return v:GetAttribute("Police") end)
                    if attr and attr then isPolice = true end
                end
                
                if isMurderer then table.insert(murderers, v)
                elseif isPolice then table.insert(polices, v)
                else table.insert(innocents, v) end
            end
        end
    end
    return murderers, polices, innocents
end

-- ESP fix lỗi BillboardGui
local function updateESP()
    if not flags.esp then
        for _, gui in pairs(espCache) do
            if gui and gui.Parent then
                pcall(function() gui.Enabled = false end)
            end
        end
        return
    end
    
    local murderers, polices, innocents = getRoles()
    local allPlayers = players:GetPlayers()
    
    for _, v in pairs(allPlayers) do
        if v and v ~= player then
            local char = v.Character
            if char then
                local head = char:FindFirstChild("Head")
                if head then
                    local esp = espCache[v]
                    if not esp then
                        esp = Instance.new("BillboardGui")
                        esp.Name = "ESP_" .. v.Name
                        esp.Adornee = head
                        esp.Size = UDim2.new(0, 160, 0, 32)
                        esp.AlwaysOnTop = true
                        esp.StudsOffset = Vector3.new(0, 2.5, 0)
                        esp.MaxDistance = 1000
                        local label = Instance.new("TextLabel", esp)
                        label.Size = UDim2.new(1,0,1,0)
                        label.BackgroundTransparency = 1
                        label.TextScaled = true
                        label.Font = Enum.Font.GothamBold
                        label.TextStrokeTransparency = 0.2
                        label.TextColor3 = Color3.new(1,1,1)
                        esp.Parent = char
                        espCache[v] = esp
                    else
                        esp.Adornee = head
                        esp.Parent = char
                    end
                    esp.Enabled = true
                    local label = esp:FindFirstChild("TextLabel")
                    if label then
                        label.Text = v.Name
                        if table.find(murderers, v) then
                            label.TextColor3 = Color3.new(1,0,0)
                            label.TextStrokeColor3 = Color3.new(0.4,0,0)
                        elseif table.find(polices, v) then
                            label.TextColor3 = Color3.new(0.2,0.5,1)
                            label.TextStrokeColor3 = Color3.new(0,0,0.5)
                        else
                            label.TextColor3 = Color3.new(0,1,0)
                            label.TextStrokeColor3 = Color3.new(0,0.4,0)
                        end
                    end
                end
            else
                if espCache[v] then
                    pcall(function() espCache[v]:Destroy() end)
                    espCache[v] = nil
                end
            end
        end
    end
end

-- Teleport an toàn (fix lỗi CFrame)
local function teleportTo(target)
    if not target or not target.Character then return false end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local myChar = getCharacter()
    if not myChar then return false end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    pcall(function()
        myHrp.CFrame = hrp.CFrame + Vector3.new(0, 2.5, 0)
    end)
    return true
end

local function teleportAllInnocentToMe()
    local _, _, innocents = getRoles()
    local myChar = getCharacter()
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    for _, v in pairs(innocents) do
        if v and v.Character then
            local hrp = v.Character:FindFirstChild("HumanoidRootPart")
            if hrp then
                pcall(function()
                    hrp.CFrame = myHrp.CFrame + Vector3.new(math.random(-5,5), 2, math.random(-5,5))
                end)
            end
        end
    end
end

local function teleportMurdererToMe()
    local murderers, _, _ = getRoles()
    if not murderers or #murderers == 0 then return end
    local target = murderers[1]
    if not target or not target.Character then return end
    local hrp = target.Character:FindFirstChild("HumanoidRootPart")
    if not hrp then return end
    local myChar = getCharacter()
    if not myChar then return end
    local myHrp = myChar:FindFirstChild("HumanoidRootPart")
    if not myHrp then return end
    pcall(function()
        hrp.CFrame = myHrp.CFrame + Vector3.new(0, 2, 3)
    end)
end

-- Invisible fix lỗi phần
local function setInvisible(state)
    local char = getCharacter()
    if not char then return end
    local parts = char:GetDescendants()
    for _, part in pairs(parts) do
        if part:IsA("BasePart") then
            pcall(function()
                part.Transparency = state and 1 or 0
                if state then
                    part.CanCollide = false
                else
                    part.CanCollide = true
                end
            end)
        end
    end
    -- Ẩn accessories
    local accessories = char:GetChildren()
    for _, acc in pairs(accessories) do
        if acc:IsA("Accessory") then
            local handle = acc:FindFirstChild("Handle")
            if handle and handle:IsA("BasePart") then
                pcall(function()
                    handle.Transparency = state and 1 or 0
                end)
            end
        end
    end
end

-- Noclip fix lỗi cache
local noclipCache = {}
local function setNoclip(state)
    local char = getCharacter()
    if not char then return end
    if state then
        local parts = char:GetDescendants()
        for _, part in pairs(parts) do
            if part:IsA("BasePart") then
                pcall(function()
                    part.CanCollide = false
                    noclipCache[part] = true
                end)
            end
        end
    else
        for part in pairs(noclipCache) do
            if part and part.Parent then
                pcall(function() part.CanCollide = true end)
            end
        end
        noclipCache = {}
    end
end

-- Godmode fix lỗi hook
local godmodeHook = nil
local function setGodmode(state)
    local hum = getHumanoid()
    if not hum then return end
    if state then
        pcall(function()
            hum.MaxHealth = 1e9
            hum.Health = 1e9
            if not godmodeHook then
                local oldTake = hum.TakeDamage
                hum.TakeDamage = function(self, amount)
                    if flags.godmode then
                        return nil
                    else
                        return oldTake and oldTake(self, amount) or nil
                    end
                end
                godmodeHook = true
            end
        end)
    else
        pcall(function()
            hum.MaxHealth = 100
            hum.Health = 100
            if godmodeHook then
                hum.TakeDamage = nil
                godmodeHook = false
            end
        end)
    end
end

-- Speed fix lỗi
local function setSpeed(mult)
    local hum = getHumanoid()
    if hum then
        pcall(function()
            hum.WalkSpeed = mult
        end)
    end
end

-- Fix Lag an toàn
local function setFixLag(state)
    pcall(function()
        if state then
            settings().Rendering.QualityLevel = 1
            settings().Rendering.AutoFRMLevel = true
            runService:SetThrottleFpsEnabled(true)
            if camera then
                camera.FieldOfView = 70
            end
            -- Tắt hiệu ứng an toàn
            local allDesc = workspace:GetDescendants()
            for _, v in pairs(allDesc) do
                if v and v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Beam") or 
                   v:IsA("Fire") or v:IsA("Smoke") or v:IsA("Sparkles") then
                    pcall(function() v.Enabled = false end)
                end
                if v and v:IsA("Shadow") then
                    pcall(function() v.Enabled = false end)
                end
            end
        else
            settings().Rendering.QualityLevel = 10
            runService:SetThrottleFpsEnabled(false)
            if camera then
                camera.FieldOfView = 90
            end
        end
    end)
end

-- Vòng lặp chính fix lỗi
runService.Heartbeat:Connect(function()
    local now = tick()
    if now - lastUpdate < updateInterval then return end
    lastUpdate = now
    
    -- Cập nhật character
    character = getCharacter()
    humanoid = getHumanoid()
    
    -- ESP
    if flags.esp then
        pcall(updateESP)
    else
        for _, gui in pairs(espCache) do
            if gui and gui.Parent then
                pcall(function() gui.Enabled = false end)
            end
        end
    end
    
    -- Duy trì trạng thái an toàn
    if flags.godmode and humanoid then
        pcall(function()
            if humanoid.Health < 1e8 then
                humanoid.Health = 1e9
            end
        end)
    end
    
    if flags.invisible then
        pcall(function() setInvisible(true) end)
    end
    
    if flags.noclip then
        pcall(function() setNoclip(true) end)
    end
    
    if flags.speed then
        pcall(function() setSpeed(36) end)
    else
        pcall(function() setSpeed(16) end)
    end
    
    if flags.fixLag then
        pcall(function() setFixLag(true) end)
    end
end)

