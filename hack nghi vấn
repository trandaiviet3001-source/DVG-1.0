-- =====================================================================
-- TÌM KẺ GIẾT (AI CẦM DAO)
-- =====================================================================
local function FindMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Character then
                for _, v in pairs(p.Character:GetChildren()) do
                    if v:IsA("Tool") then
                        local tn = v.Name:lower()
                        if tn:find("knife") or tn:find("dao") or tn:find("sword") or tn:find("blade") or tn:find("dagger") or tn:find("kill") then
                            return p
                        end
                    end
                end
            end
            if p.Backpack then
                for _, v in pairs(p.Backpack:GetChildren()) do
                    if v:IsA("Tool") then
                        local tn = v.Name:lower()
                        if tn:find("knife") or tn:find("dao") then return p end
                    end
                end
            end
        end
    end
    return nil
end

-- =====================================================================
-- ESP ĐỎ
-- =====================================================================
local circles = {}
local texts = {}

local function UpdateESP()
    for _, player in pairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if not player.Character or not player.Character:FindFirstChild("Head") then
            if circles[player.Name] then pcall(function() circles[player.Name]:Remove() end); circles[player.Name] = nil end
            if texts[player.Name] then pcall(function() texts[player.Name]:Remove() end); texts[player.Name] = nil end
            continue
        end
        local head = player.Character:FindFirstChild("Head")
        local root = player.Character:FindFirstChild("HumanoidRootPart")
        if not head or not root then continue end
        
        if not circles[player.Name] then
            local c = Drawing.new("Circle"); c.Radius = 8; c.Thickness = 2; c.Filled = false; circles[player.Name] = c
        end
        if not texts[player.Name] then
            local t = Drawing.new("Text"); t.Size = 14; t.Center = true; t.Outline = true; texts[player.Name] = t
        end
        
        local headPos, onScreen = Camera:WorldToViewportPoint(head.Position)
        local dist = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") 
            and (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude or 0
        
        if onScreen and dist < 500 and S.ESP then
            circles[player.Name].Position = Vector2.new(headPos.X, headPos.Y)
            circles[player.Name].Color = Color3.new(1, 0, 0)
            circles[player.Name].Visible = true
            local distText = dist >= 1000 and string.format("%.2f km", dist/1000) or string.format("%.0f m", dist)
            texts[player.Name].Position = Vector2.new(headPos.X, headPos.Y - 22)
            texts[player.Name].Text = player.Name .. " | " .. distText
            texts[player.Name].Color = Color3.new(1, 0, 0)
            texts[player.Name].Visible = true
        else
            circles[player.Name].Visible = false; texts[player.Name].Visible = false
        end
    end
    for name, c in pairs(circles) do if not Players:FindFirstChild(name) then pcall(function() c:Remove() end); circles[name] = nil end end
    for name, t in pairs(texts) do if not Players:FindFirstChild(name) then pcall(function() t:Remove() end); texts[name] = nil end end
end

-- =====================================================================
-- GOD MODE
-- =====================================================================
local function ToggleGod()
    S.GOD = not S.GOD
    if S.GOD then spawn(function() while S.GOD do pcall(function() if LocalPlayer.Character then local h = LocalPlayer.Character:FindFirstChild("Humanoid"); if h then h.Health = h.MaxHealth end end end); wait(0.05) end end) end
end

-- =====================================================================
-- SPEED
-- =====================================================================
local function ToggleSpeed()
    S.SPD = not S.SPD
    pcall(function() if LocalPlayer.Character then local h = LocalPlayer.Character:FindFirstChild("Humanoid"); if h then h.WalkSpeed = S.SPD and 50 or 16 end end end)
end

-- =====================================================================
-- TP ĐẾN NGƯỜI CHƠI
-- =====================================================================
local function TPTo(player)
    if not player or not player.Character then return end
    local root = player.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    LocalPlayer.Character.HumanoidRootPart.CFrame = root.CFrame + Vector3.new(0, 2, 0)
end

-- =====================================================================
-- TP ĐẾN KẺ GIẾT
-- =====================================================================
local function TPToMurderer()
    local murderer = FindMurderer()
    if murderer then
        TPTo(murderer)
        StarterGui:SetCore("SendNotification", {Title = "TP KE GIET", Text = "Da TP den " .. murderer.Name, Duration = 2})
    else
        StarterGui:SetCore("SendNotification", {Title = "TP KE GIET", Text = "Chua tim thay Ke Giet!", Duration = 2})
    end
end

-- =====================================================================
-- TP ĐẾN NGƯỜI GẦN NHẤT
-- =====================================================================
local function TPToNearest()
    local best = nil; local bestD = 9999
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
            local root = p.Character:FindFirstChild("HumanoidRootPart")
            if root and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                local d = (LocalPlayer.Character.HumanoidRootPart.Position - root.Position).Magnitude
                if d < bestD then bestD = d; best = p end
            end
        end
    end
    if best then TPTo(best) end
end

-- =====================================================================
-- KÉO NGƯỜI NGẪU NHIÊN
-- =====================================================================
local function PullRandom()
    local targets = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(targets, p) end
    end
    if #targets > 0 then
        local target = targets[math.random(1, #targets)]
        pcall(function() target.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 2) end)
        StarterGui:SetCore("SendNotification", {Title = "KEO NGUOI", Text = "Da keo " .. target.Name, Duration = 2})
    end
end

-- =====================================================================
-- FIX LAG
-- =====================================================================
local function FixLag()
    pcall(function()
        Lighting.GlobalShadows = false; Lighting.FogEnd = 9999999; Lighting.Brightness = 2
        settings().Rendering.QualityLevel = 1
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") then v.Enabled = false end
        end
    end)
end

