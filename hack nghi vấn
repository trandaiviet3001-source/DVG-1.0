local function addToggle(text, key)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,-4,0,24)
    btn.Position = UDim2.new(0,2,0,#scroll:GetChildren()*27)
    btn.Text = text .. (flags[key] and " [ON]" or " [OFF]")
    btn.TextColor3 = Color3.new(0.9,0.9,0.9)
    btn.TextScaled = true
    btn.BackgroundColor3 = Color3.new(0.15,0.15,0.15)
    btn.BorderSizePixel = 0
    btn.Parent = scroll
    btn.MouseButton1Click:Connect(function()
        flags[key] = not flags[key]
        btn.Text = text .. (flags[key] and " [ON]" or " [OFF]")
        pcall(function()
            if key == "invisible" then setInvisible(flags[key])
            elseif key == "noclip" then setNoclip(flags[key])
            elseif key == "godmode" then setGodmode(flags[key])
            elseif key == "speed" then setSpeed(flags[key] and 36 or 16)
            elseif key == "fixLag" then setFixLag(flags[key])
            elseif key == "esp" then 
                if flags[key] then updateESP() 
                else 
                    for _,g in pairs(espCache) do 
                        if g then pcall(function() g.Enabled = false end) end 
                    end 
                end
            end
        end)
    end)
    return btn
end

