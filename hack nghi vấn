-- =====================================================================
-- TÌM KẺ GIẾT
-- =====================================================================
local function FindMurderer()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if p.Character then
                for _, v in pairs(p.Character:GetChildren()) do
                    if v:IsA("Tool") then
                        local tn = v.Name:lower()
                        if tn:find("knife") or tn:find("dao") or tn:find("sword") or tn:find("blade") or tn:find("dagger") or tn:find("kill") then
                            MurdererName = p.Name; return p
                        end
                    end
                end
            end
            if p.Backpack then
                for _, v in pairs(p.Backpack:GetChildren()) do
                    if v:IsA("Tool") then
                        local tn = v.Name:lower()
                        if tn:find("knife") or tn:find("dao") then MurdererName = p.Name; return p end
                    end
                end
            end
        end
    end
    return nil
end

-- =====================================================================
-- VAI TRÒ
-- =====================================================================
local function GetRole(player)
    if UserRoles[player.Name] then return UserRoles[player.Name] end
    if MurdererName and player.Name == MurdererName then return "MURDERER" end
    if player.Character then
        for _, v in pairs(player.Character:GetChildren()) do
            if v:IsA("Tool") then
                local tn = v.Name:lower()
                if tn:find("gun") or tn:find("súng") or tn:find("pistol") then return "SHERIFF"
                elseif tn:find("knife") or tn:find("dao") then return "MURDERER" end
            end
        end
    end
    if player.Team then
        local tn = player.Team.Name:lower()
        if tn:find("murder") or tn:find("kill") then return "MURDERER"
        elseif tn:find("sheriff") or tn:find("police") then return "SHERIFF"
        elseif tn:find("innocent") then return "INNOCENT" end
    end
    return "INNOCENT"
end

-- =====================================================================
-- MÀU
-- =====================================================================
local function GetColor(role)
    if role == "MURDERER" then return Color3.new(1, 0, 0)
    elseif role == "SHERIFF" then return Color3.new(0.1, 0.4, 1)
    else return Color3.new(0, 1, 0) end
end
local function GetTag(role)
    if role == "MURDERER" then return "KE GIET"
    elseif role == "SHERIFF" then return "CANH SAT"
    else return "VO TOI" end
end

-- =====================================================================
-- ESP HIGHLIGHT
-- =====================================================================
local highlights = {}
local function UpdateESP()
    pcall(function()
        for _, player in pairs(Players:GetPlayers()) do
            if player == LocalPlayer then goto continue end
            if not player.Character then
                if highlights[player.Name] then pcall(function() highlights[player.Name]:Destroy() end); highlights[player.Name] = nil end
                goto continue
            end
            if S.ESP then
                if not highlights[player.Name] then
                    local h = Instance.new("Highlight")
                    h.FillTransparency = 0.8; h.OutlineTransparency = 0
                    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    h.Parent = player.Character; highlights[player.Name] = h
                end
                local role = GetRole(player); local color = GetColor(role)
                highlights[player.Name].FillColor = color; highlights[player.Name].OutlineColor = color
            else
                if highlights[player.Name] then pcall(function() highlights[player.Name]:Destroy() end); highlights[player.Name] = nil end
            end
            ::continue::
        end
        for name, h in pairs(highlights) do
            if not Players:FindFirstChild(name) then pcall(function() h:Destroy() end); highlights[name] = nil end
        end
    end)
end

-- =====================================================================
-- CHỨC NĂNG
-- =====================================================================
local function ToggleGod()
    S.GOD = not S.GOD
    if S.GOD then spawn(function() while S.GOD do pcall(function() if LocalPlayer.Character then local h = LocalPlayer.Character:FindFirstChild("Humanoid"); if h then h.Health = h.MaxHealth end end end); wait(0.05) end end) end
end
local function ToggleSpeed()
    S.SPD = not S.SPD
    pcall(function() if LocalPlayer.Character then local h = LocalPlayer.Character:FindFirstChild("Humanoid"); if h then h.WalkSpeed = S.SPD and 50 or 16 end end end)
end
local function ToggleInvis()
    S.INVIS = not S.INVIS
    if S.INVIS then
        spawn(function()
            while S.INVIS and LocalPlayer.Character do
                pcall(function()
                    for _, part in pairs(LocalPlayer.Character:GetChildren()) do
                        if part:IsA("BasePart") then part.Transparency = 1; part.CanCollide = false
                        elseif part:IsA("Decal") then part.Transparency = 1 end
                    end
                    local head = LocalPlayer.Character:FindFirstChild("Head"); if head then head.Transparency = 1 end
                    local hum = LocalPlayer.Character:FindFirstChild("Humanoid")
                    if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None; hum.NameDisplayDistance = 0; hum.HealthDisplayDistance = 0 end
                end)
                wait(0.1)
            end
        end)
    end
end
local function TPTo(player)
    if not player or not player.Character then return end
    local root = player.Character:FindFirstChild("HumanoidRootPart"); if not root then return end
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then return end
    LocalPlayer.Character.HumanoidRootPart.CFrame = root.CFrame + Vector3.new(0, 2, 0)
end
local function PullRandom()
    local targets = {}
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then table.insert(targets, p) end
    end
    if #targets > 0 then
        local target = targets[math.random(1, #targets)]
        pcall(function() target.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 0, 2) end)
        StarterGui:SetCore("SendNotification", {Title = "KEO NGUOI", Text = "Da keo " .. target.Name, Duration = 2})
    end
end
local function FixLag()
    pcall(function()
        Lighting.GlobalShadows = false; Lighting.FogEnd = 9999999; Lighting.Brightness = 2
        settings().Rendering.QualityLevel = 1
        for _, v in pairs(Workspace:GetDescendants()) do
            if v:IsA("ParticleEmitter") or v:IsA("Smoke") or v:IsA("Fire") then v.Enabled = false end
        end
    end)
end

