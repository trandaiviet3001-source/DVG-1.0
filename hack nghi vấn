    local qf = Instance.new("Frame", qm); qf.Size = UDim2.new(0, 150, 0, 120); qf.Position = UDim2.new(0, position.X, 0, position.Y)
    qf.BackgroundColor3 = Color3.fromRGB(10,10,15); qf.BorderColor3 = Color3.fromRGB(255,255,255)
    local role = GetRole(player)
    local qt = Instance.new("TextLabel", qf); qt.Size = UDim2.new(1,0,0,22); qt.BackgroundColor3 = GetColor(role)
    qt.Text = player.Name .. " - " .. GetTag(role); qt.TextColor3 = Color3.new(1,1,1); qt.Font = Enum.Font.SourceSansBold; qt.TextSize = 10
    local roles = {
        {"🔴 KE GIET", "MURDERER", Color3.fromRGB(200, 30, 30)},
        {"🔵 CANH SAT", "SHERIFF", Color3.fromRGB(30, 60, 200)},
        {"🟢 VO TOI", "INNOCENT", Color3.fromRGB(30, 180, 30)},
    }
    for i, r in pairs(roles) do
        local b = Instance.new("TextButton", qf); b.Size = UDim2.new(1,-8,0,22); b.Position = UDim2.new(0,4,0,24+(i-1)*24)
        b.BackgroundColor3 = r[3]; b.Text = r[1]; b.TextColor3 = Color3.new(1,1,1); b.Font = Enum.Font.SourceSans; b.TextSize = 10
        b.MouseButton1Click:Connect(function() UserRoles[player.Name] = r[2]; qm:Destroy() end)
    end
    local resetBtn = Instance.new("TextButton", qf); resetBtn.Size = UDim2.new(1,-8,0,22); resetBtn.Position = UDim2.new(0,4,0,96)
    resetBtn.BackgroundColor3 = Color3.fromRGB(100,100,100); resetBtn.Text = "❌ XOA"; resetBtn.TextColor3 = Color3.new(1,1,1); resetBtn.Font = Enum.Font.SourceSans; resetBtn.TextSize = 10
    resetBtn.MouseButton1Click:Connect(function() UserRoles[player.Name] = nil; qm:Destroy() end)
    spawn(function() wait(10); if qm.Parent then qm:Destroy() end end)
end
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.UserInputType == Enum.UserInputType.MouseButton2 then
        local mousePos = UserInputService:GetMouseLocation()
        for _, p in pairs(Players:GetPlayers()) do
            if p == LocalPlayer or not p.Character or not p.Character:FindFirstChild("Head") then continue end
            local hp, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
            if onScreen and (Vector2.new(hp.X, hp.Y) - mousePos).Magnitude < 80 then ShowRoleMenu(p, mousePos); break end
        end
    end
end)

