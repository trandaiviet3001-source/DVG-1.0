local function ChongBan()
    pcall(function()
        -- Chặn error reporting
        local LogService = game:GetService("LogService")
        if LogService then
            LogService.MessageOut:Connect(function() return nil end)
            LogService.ErrorOut:Connect(function() return nil end)
        end
        
        -- Hook __index để chặn hàm phát hiện
        local danhSachChan = {
            "DetectInjectedScript", "IsExploitDetected", "CheckForCheats",
            "VerifyScriptIntegrity", "ScanForSuspiciousActivity", "ReportExploitAttempt",
            "FlagCheater", "AntiCheatCheck", "CheckExploit", "DetectExploit",
            "AntiCheatSignal", "CheatReport", "FlagPlayer", "SendToModeration"
        }
        
        -- Hook metacethod an toàn
        pcall(function()
            local oldIndex = hookmetamethod(game, "__index", function(self, key)
                for _, v in ipairs(danhSachChan) do
                    if key == v then
                        return function() return false end
                    end
                end
                return oldIndex(self, key)
            end)
        end)
        
        -- Chặn HttpService telemetry
        pcall(function()
            local HttpService = game:GetService("HttpService")
            local oldRequest = HttpService.RequestAsync
            HttpService.RequestAsync = function(self, data, ...)
                if data and data.Url then
                    local urlChan = {
                        "roblox.com/analytics", 
                        "roblox.com/telemetry", 
                        "roblox.com/report",
                        "roblox.com/log",
                        "roblox.com/tracking"
                    }
                    for _, url in ipairs(urlChan) do
                        if data.Url:find(url) then
                            return {Success = true, StatusCode = 200, Body = "{}"}
                        end
                    end
                end
                return oldRequest(self, data, ...)
            end
        end)
        
        print("[Chống Ban] Đã kích hoạt cho PC")
    end)
end

