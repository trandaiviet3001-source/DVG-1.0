-- Bay
local function BatDauBay()
    if KetNoi.Bay then KetNoi.Bay:Disconnect() end
    local bodyVelocity = Instance.new("BodyVelocity")
    bodyVelocity.MaxForce = Vector3.new(1, 1, 1) * math.huge
    bodyVelocity.Velocity = Vector3.new(0, 0, 0)
    bodyVelocity.Parent = HumanoidRootPart
    
    local bodyGyro = Instance.new("BodyGyro")
    bodyGyro.MaxTorque = Vector3.new(1, 1, 1) * math.huge
    bodyGyro.CFrame = HumanoidRootPart.CFrame
    bodyGyro.Parent = HumanoidRootPart
    
    KetNoi.Bay = RunService.RenderStepped:Connect(function()
        if not TrangThaiHack.Bay then
            bodyVelocity:Destroy()
            bodyGyro:Destroy()
            KetNoi.Bay:Disconnect()
            return
        end
        
        local huong = Vector3.new(0, 0, 0)
        if UserInputService:IsKeyDown(Enum.KeyCode.W) then huong += Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) then huong -= Camera.CFrame.LookVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.A) then huong -= Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.D) then huong += Camera.CFrame.RightVector end
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then huong += Vector3.new(0, 1, 0) end
        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then huong -= Vector3.new(0, 1, 0) end
        
        bodyVelocity.Velocity = huong * 50
        bodyGyro.CFrame = Camera.CFrame
    end)
end

